{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:marketplace",
  "outputDirectory": "dist/marketplace",
  "framework": null,
  "env": {
    "KRISTIVA_APP": "marketplace"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/products/:id",
      "destination": "/index.html"
    },
    {
      "source": "/orders/:id",
      "destination": "/index.html"
    }
  ]
}
